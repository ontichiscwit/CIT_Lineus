# [AX Lab] combine-ai-server 설정 예시 (2026-10-21)
# 이 파일을 같은 폴더에 .env 로 복사해 값을 채운다. .env 는 git 에 올라가지 않는다(루트 .gitignore).
# 터미널에서 set/$env: 로 준 값이 있으면 그쪽이 우선한다.

# AI PC(Mac) 연결 끊김/복구 알림 메일 — 그룹웨어(gw.cwit.co.kr:25) 로그인 비밀번호
COMBINE_ALERT_SMTP_PASSWORD=
# 아래는 기본값과 같으면 비워 두거나 지워도 된다
# COMBINE_ALERT_SMTP_USER=25022
# COMBINE_ALERT_MAIL_FROM=hyerin.yu@cwit.co.kr
# COMBINE_ALERT_MAIL_TO=hyerin.yu@cwit.co.kr
