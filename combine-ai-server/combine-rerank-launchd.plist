<?xml version="1.0" encoding="UTF-8"?>
<!-- [AX Lab] macOS AI PC 재정렬 서버 자동 기동(로그인 시 기동 · 비정상 종료 시 재기동)
     설치: cp combine-rerank-launchd.plist ~/Library/LaunchAgents/com.axlab.combine-rerank.plist
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.axlab.combine-rerank.plist
     재기동: launchctl kickstart -k gui/$(id -u)/com.axlab.combine-rerank
     해제: launchctl bootout gui/$(id -u)/com.axlab.combine-rerank
     경로는 /Users/axlab/workspace/combine-ai-server 기준이다. 운영 키는 EnvironmentVariables에 넣는다. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.axlab.combine-rerank</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/axlab/workspace/combine-ai-server/combine-rerank-run.sh</string>
        <string>0.0.0.0</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/axlab/workspace/combine-ai-server</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>COMBINE_RERANK_API_KEY</key>
        <string>dev-key</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/Users/axlab/workspace/combine-ai-server/combine-rerank.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/axlab/workspace/combine-ai-server/combine-rerank.log</string>
</dict>
</plist>
