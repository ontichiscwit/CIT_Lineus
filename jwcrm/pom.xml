	                    <contextFile>${project.basedir}/local-run/tomcat-context.xml</contextFile>
	                    <!-- [AX Lab] 수정 끝 -->
	                    <path>/</path>
	                    <systemProperties>
	                        <JAVA_OPTS>-Xms256m -Xmx768m -XX:MaxPermSize=256m</JAVA_OPTS>
	                    </systemProperties>
	                </configuration>
	            </plugin>
                <!-- 
