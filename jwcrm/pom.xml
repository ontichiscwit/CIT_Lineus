	                <artifactId>tomcat7-maven-plugin</artifactId>
	                <version>2.2</version>
	                <configuration>
	                    <!-- [AX Lab] 수정 시작 (2026-07-24): 로컬 실행(mvn tomcat7:run)용. 원본 port=80 -> 8080, 로컬 JNDI 데이터소스 컨텍스트 파일 연결. 운영 배포(WAR)와 무관. -->
