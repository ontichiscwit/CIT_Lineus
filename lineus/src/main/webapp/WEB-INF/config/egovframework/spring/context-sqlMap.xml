   <!-- Session time의 설정 -->
   <bean id="stForCommon" class="org.mybatis.spring.SqlSessionTemplate">
   	<constructor-arg ref="sqlSession"/>
   </bean>
  
  <!-- TRANSACTION -->
  <bean id="tmForCommon" class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
  	<property name="dataSource" ref="dsForCommon"/>
  </bean>
  <!--
  <bean id="tmForCommonMS" class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
  	<property name="dataSource" ref="dsMsSource"/>
  </bean>-->
  
  <!-- ROLL DEF -->
  <tx:advice id="txForCommon" transaction-manager="tmForCommon">
  	<tx:attributes>
  		<tx:method name="select*" read-only="true"/>
  		<tx:method name="delete*" propagation="REQUIRED" rollback-for="Exception"/>
  		<tx:method name="update*" propagation="REQUIRED" rollback-for="Exception"/>
  		<tx:method name="insert*" propagation="REQUIRED" rollback-for="Exception"/>
  		<tx:method name="proc*" propagation="REQUIRED" rollback-for="Exception"/>
  	</tx:attributes>
  </tx:advice>
