  <!-- MYBATIS SETTING Oracle-->
  <bean id="sqlSession" class="org.mybatis.spring.SqlSessionFactoryBean">
  	<property name="dataSource" ref="dsForCommon"/>
	<property name="configLocation" value="/WEB-INF/config/egovframework/spring/mybatis-config.xml"/>
	<property name="typeAliasesPackage" value="egovframework.com"/>
	<property name="mapperLocations" value="classpath:query/egov-*.xml"/>
  </bean>
  
