  <!-- TRANSACTION - SERVICE / SERVICEIMPL -->
  <aop:config>
  	<aop:pointcut id="pcForCommonService" expression="execution(* egovframework.com..*Service.*(..))" />
        <aop:pointcut id="pcForCommonServiceImpl" expression="execution(* egovframework.com..*ServiceImpl.*(..))" />
        <aop:advisor advice-ref="tmForCommon" order="2" pointcut-ref="pcForCommonService" />
        <aop:advisor advice-ref="tmForCommon" order="2" pointcut-ref="pcForCommonServiceImpl" />   
  </aop:config>
